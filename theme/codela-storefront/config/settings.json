{
  "schema_version": 1,
  "sections": [
    {
      "id": "header",
      "label": "Header",
      "description": "Branding and navigation in the top bar.",
      "fields": [
        {
          "id": "brand",
          "type": "text",
          "label": "Brand name",
          "description": "Used when there is no custom logo and in the footer.",
          "maxlength": 100,
          "placeholder": "Store name"
        },
        {
          "id": "menu_id",
          "type": "menu",
          "label": "Main menu",
          "description": "Choose an existing WordPress menu, or use automatic product categories."
        },
        {
          "id": "mobile_dock_enabled",
          "type": "checkbox",
          "default": true,
          "label": "Mobile bottom navigation",
          "description": "Show the bottom navigation on mobile. When disabled, search, cart and account appear in the header, as on desktop."
        }
      ]
    },
    {
      "id": "homepage",
      "label": "Ana Sayfa · Genel",
      "description": "Tema bölümleri: Slider → Kategori tanıtımları → Ürün bölümleri. Mevcut sayfa içeriğiniz korunur.",
      "fields": [
        {
          "id": "homepage_mode",
          "type": "select",
          "label": "Ana sayfa düzeni",
          "default": "legacy",
          "options": {
            "legacy": "Mevcut düzeni koru",
            "sections": "Tema bölümleri",
            "page_content": "WordPress sayfa içeriği"
          }
        },
        {
          "id": "hero_product_id",
          "type": "product",
          "label": "Homepage featured product",
          "description": "Enter a published product ID, or 0 for the newest visible product. A static homepage uses its own editable page content."
        }
      ]
    },
    {
      "id": "homepage-slider",
      "label": "Ana Sayfa · Slider",
      "description": "Yatay kaydırılır. Otomatik oynatma yok; metinler ve buton isteğe bağlıdır.",
      "fields": [
        {
          "id": "homepage_slides",
          "type": "repeater",
          "label": "Slaytlar",
          "max_items": 8,
          "fields": [
            {
              "id": "enabled",
              "type": "checkbox",
              "label": "Göster",
              "default": true
            },
            {
              "id": "image_id",
              "type": "image",
              "label": "Görsel"
            },
            {
              "id": "mobile_image_id",
              "type": "image",
              "label": "Mobil görsel (isteğe bağlı)"
            },
            {
              "id": "title",
              "type": "text",
              "label": "Başlık",
              "maxlength": 100
            },
            {
              "id": "subtitle",
              "type": "textarea",
              "label": "Alt metin",
              "maxlength": 300
            },
            {
              "id": "button_label",
              "type": "text",
              "label": "Buton metni",
              "maxlength": 40
            },
            {
              "id": "button_url",
              "type": "url",
              "label": "Bağlantı"
            }
          ]
        }
      ]
    },
    {
      "id": "homepage-categories",
      "label": "Ana Sayfa · Kategoriler",
      "description": "Kategori görselleri ve tanıtımları; ürün fiyatı ve sepet düğmesi içermez.",
      "fields": [
        {
          "id": "homepage_categories_enabled",
          "type": "checkbox",
          "label": "Kategori tanıtımlarını göster",
          "default": true
        },
        {
          "id": "homepage_categories_title",
          "type": "text",
          "label": "Bölüm başlığı",
          "default": "Kategorileri keşfet"
        },
        {
          "id": "homepage_categories",
          "type": "repeater",
          "label": "Kategori tanıtımları",
          "max_items": 12,
          "fields": [
            {
              "id": "term_id",
              "type": "category",
              "label": "Kategori"
            },
            {
              "id": "title",
              "type": "text",
              "label": "Özel başlık (isteğe bağlı)"
            },
            {
              "id": "description",
              "type": "textarea",
              "label": "Kısa tanıtım (isteğe bağlı)",
              "maxlength": 160
            },
            {
              "id": "image_id",
              "type": "image",
              "label": "Özel görsel (isteğe bağlı)"
            }
          ]
        }
      ]
    },
    {
      "id": "homepage-products",
      "label": "Ana Sayfa · Ürün Bölümleri",
      "description": "En fazla dört bölüm. Sıralarını yukarı/aşağı düğmeleriyle veya tutamaktan sürükleyerek değiştirin.",
      "fields": [
        {
          "id": "homepage_sections",
          "type": "repeater",
          "label": "Ürün bölümleri",
          "max_items": 4,
          "fields": [
            {
              "id": "enabled",
              "type": "checkbox",
              "label": "Göster",
              "default": true
            },
            {
              "id": "title",
              "type": "text",
              "label": "Bölüm başlığı"
            },
            {
              "id": "source",
              "type": "select",
              "label": "Ürün seçimi",
              "default": "new",
              "options": {
                "new": "Yeni ürünler",
                "best_sellers": "Çok satanlar"
              }
            },
            {
              "id": "category_id",
              "type": "category",
              "label": "Kategori filtresi",
              "description": "Tüm kategoriler veya seçilen kategori ve alt kategorileri."
            },
            {
              "id": "limit",
              "type": "select",
              "label": "Ürün adedi",
              "default": "4",
              "options": {
                "4": "4",
                "8": "8",
                "12": "12"
              }
            },
            {
              "id": "show_all",
              "type": "checkbox",
              "label": "Tümünü gör bağlantısı",
              "default": true
            }
          ]
        }
      ]
    },
    {
      "id": "product",
      "label": "Product page",
      "description": "Product gallery presentation.",
      "fields": [
        {
          "id": "product_gallery_thumbnails",
          "type": "checkbox",
          "default": true,
          "label": "Show gallery thumbnails",
          "description": "Show selectable thumbnails below the product gallery. Swipe remains available."
        }
      ]
    },
    {
      "id": "footer",
      "label": "Footer",
      "description": "Compact, one-line copyright and legal links.",
      "fields": [
        {
          "id": "footer_text",
          "type": "text",
          "label": "Footer note",
          "description": "Optional short note inline with the brand on desktop. Hidden on narrow mobile screens to keep one row.",
          "maxlength": 160,
          "placeholder": ""
        }
      ]
    }
  ],
  "settings_api": "1.1.0"
}
